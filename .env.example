# Shikshan Environment Configuration
# Copy this file to .env.local or .env for local development

# Supabase Project URL (e.g., https://your-project.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Public API Key (safe for frontend use with RLS enabled)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Public site URL for authentication redirects (defaults to window.location.origin)
VITE_SITE_URL=http://localhost:5173
